# =============================================================================
# Notification Service - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the actual values:
#   cp .env.example .env
# =============================================================================

# -- Database --
# Local PostgreSQL (Docker Compose):
POSTGRESQL_URL=postgresql://campus_user:campus_pass@postgres:5432/campus_event_hub

# Cloud PostgreSQL (Supabase) - uncomment and use instead if needed:
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_KEY=your-supabase-anon-key
# project_password=your-db-password
# POSTGRESQL_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres

# -- JWT Authentication --
SECRET_KEY=your-jwt-secret-key
ALGORITHM=HS256

# -- Kafka (Message Broker) --
# Use "kafka:29092" when running with Docker Compose
# Use "localhost:9092" when running locally
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# -- Python --
PYTHONUNBUFFERED=1
